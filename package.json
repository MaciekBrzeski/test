{
  "name": "pixelpdf-e2e",
  "private": true,
  "description": "Browser end-to-end tests (Playwright) and JavaScript coverage for pixelpdf",
  "scripts": {
    "test": "npm run test:py && npm run coverage:js && npm run e2e",
    "test:py": "python3 -m pytest -q --cov --cov-report=term-missing",
    "coverage:js": "c8 --check-coverage --lines 90 --functions 90 --branches 85 --include 'pixelpdf/interactive/**/*.js' --reporter text python3 -m pytest -q tests/test_interactive.py",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:pdfjs": "playwright test --project=pdfjs",
    "e2e:firefox": "playwright test --project=firefox"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "c8": "^10.1.3",
    "pdfjs-dist": "^5.4.149",
    "pngjs": "^7.0.0"
  }
}
